<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The dashboard's web server as a LaunchDaemon: runs as you (UserName) from boot, whether or not you are logged in
     or another macOS user has the screen – so the page always loads instead of a 502. It only serves files and
     status.json; everything that talks to Mail and Messages stays in the action service (a LaunchAgent in your
     session). Install: docs/SETUP.md "Keep it running when other users log in". -->
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <key>UserName</key><string>__USER__</string>
  <key>GroupName</key><string>staff</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__WWW_DIR__/www-server.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>__HOME__</string></dict>
  <key>WorkingDirectory</key><string>__WWW_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__LOG_DIR__/web.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/web.log</string>
</dict>
</plist>
